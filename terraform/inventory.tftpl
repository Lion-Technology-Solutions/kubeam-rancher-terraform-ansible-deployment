# Generated by Terraform. Do not edit by hand.

[kube_control_plane]
%{ for node in master_nodes ~}
${node.name} ansible_host=${node.public_ip} public_ip=${node.public_ip} private_ip=${node.private_ip} node_role=control-plane
%{ endfor ~}

[kube_workers]
%{ for node in worker_nodes ~}
${node.name} ansible_host=${node.public_ip} public_ip=${node.public_ip} private_ip=${node.private_ip} node_role=worker
%{ endfor ~}

[kube_cluster:children]
kube_control_plane
kube_workers

[all:vars]
ansible_user=ubuntu
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file=${ssh_private_key_path}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
kubernetes_version=${kubernetes_version}
pod_network_cidr=${pod_network_cidr}
